# copy to .env and fill in

# Postgres — runtime uses the POOLED url, migrations use the DIRECT url.
# Locally the two are identical (docker-compose provides this exact URL, no pooler).
# This file configures the optional Node server. Brclio production uses Pages with GitHub storage.
DATABASE_URL=postgresql://klar:klar@localhost:5432/klarbase
DIRECT_URL=postgresql://klar:klar@localhost:5432/klarbase

# better-auth — generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth apps — GitHub: https://github.com/settings/developers
#   callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials
#   callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# client origin (dev Vite server)
CLIENT_ORIGIN=http://localhost:5173

PORT=3000

# Optional analytics key for the Node deployment. The public Brclio edition disables analytics.
VITE_POSTHOG_KEY=

# maintainer stats (GET /api/stats, aggregate counts only). Unset = endpoint off (404).
# Set the same long random value in the Node environment and your local shell. Generate: openssl rand -hex 32
STATS_TOKEN=
